generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int                @id @default(autoincrement())
  email              String             @unique
  password           String
  credits            Int                @default(0)
  apiKeys            ApiKey[]
  conversations      Conversation[]
  onrampTransactions OnrampTransacton[]
}

model ApiKey {
  id              Int            @id @default(autoincrement())
  userId          Int
  name            String
  apiKey          String         @unique
  disabled        Boolean        @default(false)
  deleted         Boolean        @default(false)
  creditsConsumed Int            @default(0)
  lastUsed        DateTime?
  user            User           @relation(fields: [userId], references: [id])
  conversations   Conversation[]
}

model Company {
  id      Int     @id @default(autoincrement())
  name    String
  website String
  models  Model[]
}

model Model {
  id                    Int                    @id @default(autoincrement())
  name                  String
  companyId             Int
  slug                  String
  company               Company                @relation(fields: [companyId], references: [id])
  modelProviderMappings ModelProviderMapping[]
}

model Provider {
  id                    Int                    @id @default(autoincrement())
  name                  String
  website               String
  modelProviderMappings ModelProviderMapping[]
}

model ModelProviderMapping {
  id              Int            @id @default(autoincrement())
  modelId         Int
  providerId      Int
  inputTokenCost  Int
  outputTokenCost Int            @map("OutputTokenCost")
  providerModelId String
  conversations   Conversation[]
  model           Model          @relation(fields: [modelId], references: [id])
  provider        Provider       @relation(fields: [providerId], references: [id])
}

model OnrampTransacton {
  id     Int    @id @default(autoincrement())
  userId Int
  amount Int
  status String
  user   User   @relation(fields: [userId], references: [id])
}

model Conversation {
  id                     Int                  @id @default(autoincrement())
  userId                 Int
  apiKeyId               Int
  modelProviderMappingId Int
  input                  String
  output                 String
  inputTokenCount        Int
  outputTokenCount       Int
  apiKey                 ApiKey               @relation(fields: [apiKeyId], references: [id])
  modelProviderMapping   ModelProviderMapping @relation(fields: [modelProviderMappingId], references: [id])
  user                   User                 @relation(fields: [userId], references: [id])
}
